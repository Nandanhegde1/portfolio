# Backend environment variables. Copy to .env and fill in.
# This list is every process.env read in app.js, server.js, lib/, routes/ and
# supabase.js. Leave a value empty to use the default or keep that feature off.

# Server
PORT=3000
# Comma-separated origins CORS allows (default http://localhost:4200)
ALLOWED_ORIGINS=http://localhost:4200

# The roast model (lib/llm.js): Gemini when GEMINI_API_KEY is set, Anthropic
# otherwise. LLM_PROVIDER=gemini or LLM_PROVIDER=anthropic forces one.
LLM_PROVIDER=
GEMINI_API_KEY=
# Default gemini-3.5-flash-lite (lib/gemini.js)
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# Model calls allowed per UTC day, counted per running instance (default 100, lib/limiters.js)
DAILY_LLM_CALL_CAP=

# Supabase (supabase.js)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin endpoints, sent in the x-admin-token header. lib/admin-auth.js reads
# ADMIN_TOKEN, then ADMIN_KEY as a legacy alias; routes/roasts.js reads ADMIN_TOKEN.
ADMIN_TOKEN=
ADMIN_KEY=

# Spotify now-playing (lib/spotify.js). Without all three the API answers
# {"isPlaying":false,"mock":true} and the site hides the widget.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
