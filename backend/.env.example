# Backend environment variables — copy to .env and fill in.
# Every variable here is actually read by the code (server.js / lib/ / routes/ / supabase.js).

# Server
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200

# Anthropic (chat + roast endpoints — lib/anthropic.js)
ANTHROPIC_API_KEY=

# Supabase (roasts + blog comments persistence — supabase.js)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin endpoints (lib/admin-auth.js)
ADMIN_KEY=
ADMIN_TOKEN=
